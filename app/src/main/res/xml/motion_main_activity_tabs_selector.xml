<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetStart="@+id/favourites_list"
        motion:constraintSetEnd="@+id/contacts"/>

    <Transition
        motion:constraintSetStart="@+id/favourites_list"
        motion:constraintSetEnd="@+id/call_history"/>

    <Transition
        motion:constraintSetStart="@+id/favourites_list"
        motion:constraintSetEnd="@+id/dialer"/>

    <Transition
        motion:constraintSetStart="@+id/contacts"
        motion:constraintSetEnd="@+id/call_history"/>

    <Transition
        motion:constraintSetStart="@+id/contacts"
        motion:constraintSetEnd="@+id/dialer"/>

    <Transition
        motion:constraintSetStart="@+id/call_history"
        motion:constraintSetEnd="@+id/dialer"/>

    <Transition
        motion:constraintSetStart="@+id/favourites_list"
        motion:constraintSetEnd="@+id/parking_slots"/>

    <Transition
        motion:constraintSetStart="@+id/contacts"
        motion:constraintSetEnd="@+id/parking_slots"/>

    <Transition
        motion:constraintSetStart="@+id/call_history"
        motion:constraintSetEnd="@+id/parking_slots"/>

    <Transition
        motion:constraintSetStart="@+id/dialer"
        motion:constraintSetEnd="@+id/parking_slots"/>

    <ConstraintSet android:id="@+id/favourites_list">

        <Constraint
            android:id="@id/selector"
            android:layout_height="@dimen/tabs_fragment_selector_size"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintLeft_toLeftOf="parent"
            motion:layout_constraintRight_toLeftOf="@id/guideline1" />

    </ConstraintSet>

    <ConstraintSet android:id="@+id/contacts">

        <Constraint
            android:id="@id/selector"
            android:layout_height="@dimen/tabs_fragment_selector_size"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintLeft_toLeftOf="@id/guideline1"
            motion:layout_constraintRight_toLeftOf="@id/guideline2" />

    </ConstraintSet>

    <ConstraintSet android:id="@+id/call_history">

        <Constraint
            android:id="@id/selector"
            android:layout_height="@dimen/tabs_fragment_selector_size"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintLeft_toLeftOf="@id/guideline2"
            motion:layout_constraintRight_toLeftOf="@id/guideline3" />

    </ConstraintSet>

    <ConstraintSet android:id="@+id/dialer">

        <Constraint
            android:id="@id/selector"
            android:layout_height="@dimen/tabs_fragment_selector_size"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintLeft_toLeftOf="@id/guideline3"
            motion:layout_constraintRight_toLeftOf="@id/guideline4" />

    </ConstraintSet>

    <ConstraintSet android:id="@+id/parking_slots">

        <Constraint
            android:id="@id/selector"
            android:layout_height="@dimen/tabs_fragment_selector_size"
            motion:layout_constraintBottom_toBottomOf="parent"
            motion:layout_constraintLeft_toLeftOf="@id/guideline4"
            motion:layout_constraintRight_toLeftOf="@id/guideline5" />

    </ConstraintSet>

</MotionScene>
