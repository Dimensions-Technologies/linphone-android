<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListItem" />

        <variable
            name="viewModel"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListViewModel" />
    </data>

    <!-- With one mailbox only the Call voicemail button shows: there's nothing to collapse it against -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/lightToolbarBackgroundColor"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:onClick="@{() -> viewModel.onBoxClicked(item)}"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="5dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@{item.expanded ? @drawable/ic_voicemail_expand_less : @drawable/ic_voicemail_expand_more}"
            android:visibility="@{item.showName ? View.VISIBLE : View.GONE}" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="@{item.showName ? View.VISIBLE : View.INVISIBLE}">

            <TextView
                style="@style/contact_name_list_cell_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@{item.title}" />

            <TextView
                style="@style/contact_number_list_cell_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@{item.subtitle}"
                android:visibility="@{item.subtitle.empty ? View.GONE : View.VISIBLE}" />
        </LinearLayout>

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voicemail_call_voicemail"
            android:onClick="@{() -> viewModel.dialVoicemail()}"
            android:padding="10dp"
            android:src="@drawable/ic_voicemail_dial" />
    </LinearLayout>
</layout>
