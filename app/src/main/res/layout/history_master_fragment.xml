<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data
        android:layout_width="4dp"
        android:layout_height="5dp">

        <import type="android.view.View" />

        <import type="org.linphone.activities.main.history.viewmodels.CallLogsFilter" />

        <variable
            name="editClickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="viewModel"
            type="org.linphone.activities.main.history.viewmodels.CallLogsListViewModel" />

        <variable
            name="contextItemViewModel"
            type="org.linphone.models.callhistory.CallHistoryItemViewModel" />

        <variable
            name="voicemailViewModel"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.slidingpanelayout.widget.SlidingPaneLayout
            android:id="@+id/sliding_pane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".MainActivity">

            <RelativeLayout
                android:layout_width="@dimen/master_fragment_width"
                android:layout_height="match_parent"
                android:background="?attr/backgroundColor"
                android:layout_gravity="start">

                <LinearLayout
                    android:id="@+id/top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="50sp"
                    android:background="?attr/lightToolbarBackgroundColor"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.333">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/button_background_drawable"
                            android:enabled="@{viewModel.filter != CallLogsFilter.ALL}"
                            android:onClick="@{() -> viewModel.showAllCallLogs()}"
                            android:gravity="center"
                            android:paddingHorizontal="15dp"
                            android:textSize="18sp"
                            android:textColor="@{viewModel.filter == CallLogsFilter.ALL ? @color/primary_color : @color/light_primary_text_color}"
                            android:text="History"/>

                        <View
                            android:visibility="@{viewModel.filter == CallLogsFilter.ALL ? View.VISIBLE : View.GONE}"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:background="@{viewModel.highlightColor}" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.333">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/button_background_drawable"
                            android:enabled="@{viewModel.filter != CallLogsFilter.MISSED}"
                            android:textColor="@{viewModel.filter == CallLogsFilter.MISSED ? @color/primary_color : @color/light_primary_text_color}"
                            android:gravity="center"
                            android:onClick="@{() -> viewModel.showOnlyMissedCallLogs()}"
                            android:paddingHorizontal="15dp"
                            android:textSize="18sp"
                            android:text="Missed"/>

                        <View
                            android:visibility="@{viewModel.filter == CallLogsFilter.MISSED ? View.VISIBLE : View.GONE}"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:background="@{viewModel.highlightColor}" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.333"
                        android:visibility="@{viewModel.showVoicemailTab ? View.VISIBLE : View.GONE, default=gone}">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/button_background_drawable"
                            android:enabled="@{viewModel.filter != CallLogsFilter.VOICEMAIL}"
                            android:gravity="center"
                            android:onClick="@{() -> viewModel.showVoicemail()}"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:textColor="@{viewModel.filter == CallLogsFilter.VOICEMAIL ? @color/primary_color : @color/light_primary_text_color}"
                                android:text="@string/voicemail_tab"/>

                            <!-- New voicemails, or a spinner while they refresh -->
                            <ProgressBar
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:indeterminate="true"
                                android:visibility="@{viewModel.isRefreshingVoicemail ? View.VISIBLE : View.GONE, default=gone}" />

                            <TextView
                                style="@style/unread_count_font"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="center"
                                android:background="@drawable/unread_message_count_bg"
                                android:text="@{String.valueOf(viewModel.newVoicemailCount)}"
                                android:visibility="@{!viewModel.isRefreshingVoicemail &amp;&amp; viewModel.newVoicemailCount > 0 ? View.VISIBLE : View.GONE, default=gone}" />
                        </LinearLayout>

                        <View
                            android:visibility="@{viewModel.filter == CallLogsFilter.VOICEMAIL ? View.VISIBLE : View.GONE}"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:background="@{viewModel.highlightColor}" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:visibility="@{viewModel.showConferencesFilter ? View.VISIBLE : View.INVISIBLE}">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/button_background_drawable"
                            android:contentDescription="@string/content_description_show_missed_calls"
                            android:enabled="@{viewModel.filter != CallLogsFilter.CONFERENCE}"
                            android:gravity="center"
                            android:onClick="@{() -> viewModel.showOnlyConferenceCallLogs()}"
                            android:padding="8dp"
                            android:src="@drawable/icon_video_conf_history_filter" />

                        <View
                            android:visibility="@{viewModel.filter == CallLogsFilter.CONFERENCE ? View.VISIBLE : View.GONE}"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_alignParentBottom="true"
                            android:background="@{viewModel.highlightColor}" />

                    </RelativeLayout>


                </LinearLayout>

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/list_edit_top_bar_fragment"
                    android:name="org.linphone.activities.main.fragments.ListTopBarFragment"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/main_activity_top_bar_size"
                    android:layout_alignTop="@id/top_bar"
                    tools:layout="@layout/list_edit_top_bar_fragment" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@{ viewModel.message, default=`Loading call history...`}"
                    android:visibility="@{viewModel.filter == CallLogsFilter.VOICEMAIL ? View.GONE : View.VISIBLE}"
                    style="@style/empty_list_font" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/callLogsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/top_bar"
                    android:layout_marginTop="-1dp"
                    android:visibility="@{viewModel.filter == CallLogsFilter.VOICEMAIL ? View.GONE : View.VISIBLE}"/>

                <!-- Voicemail tab: the player is pinned above the list so it stays in reach in a long mailbox -->
                <LinearLayout
                    android:id="@+id/voicemail_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/top_bar"
                    android:orientation="vertical"
                    android:visibility="@{viewModel.filter == CallLogsFilter.VOICEMAIL ? View.VISIBLE : View.GONE, default=gone}">

                    <!-- WI 36610: the mailbox shown (a picker of the others when there's more than one), and the
                         Call voicemail button beside it, as iOS's mailbox bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="@{voicemailViewModel.hasBoxes ? View.VISIBLE : View.GONE, default=gone}">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/voicemail_box_selector_background"
                            android:contentDescription="@{voicemailViewModel.boxDescription}"
                            android:onClick="@{() -> voicemailViewModel.onBoxBarClicked()}"
                            android:paddingHorizontal="12dp"
                            app:tooltip="@{voicemailViewModel.boxTitle}">

                            <!-- Clear of the arrow, which shows with more than one mailbox -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingEnd="@{voicemailViewModel.hasManyBoxes ? @dimen/voicemail_box_arrow_space : @dimen/margin_0dp}">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:text="@{voicemailViewModel.boxTitle}"
                                    android:textColor="?attr/primaryTextColor"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true"
                                    android:alpha="0.6"
                                    android:text="@{voicemailViewModel.boxBadge}"
                                    android:textColor="?attr/primaryTextColor"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="end|center_vertical"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_voicemail_expand_more"
                                android:visibility="@{voicemailViewModel.hasManyBoxes ? View.VISIBLE : View.GONE, default=gone}" />
                        </FrameLayout>

                        <!-- Calls voicemail -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/voicemail_fab_background"
                            android:contentDescription="@string/voicemail_call_voicemail"
                            android:onClick="@{() -> voicemailViewModel.dialVoicemail()}"
                            android:padding="12dp"
                            android:src="@drawable/ic_voicemail_dial"
                            app:tint="@android:color/white"
                            app:highlightFill="@{viewModel.voicemailButtonColor}"
                            app:highlightIcon="@{viewModel.voicemailButtonIconColor}"
                            app:tooltip="@{@string/voicemail_call_voicemail}" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/dividerColor"
                        android:visibility="@{voicemailViewModel.hasBoxes ? View.VISIBLE : View.GONE, default=gone}" />

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/voicemail_player"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginHorizontal="10dp"
                        android:visibility="gone"
                        app:controller_layout_id="@layout/media_player_controls"
                        app:player_layout_id="@layout/media_player_view"
                        app:show_timeout="0"
                        app:surface_type="none"
                        app:time_bar_scrubbing_enabled="true" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/voicemailList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            style="@style/empty_list_font"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/voicemail_none"
                            android:visibility="@{voicemailViewModel.isEmpty ? View.VISIBLE : View.GONE, default=gone}" />
                    </FrameLayout>
                </LinearLayout>
<!--
                <TextView
                    style="@style/empty_list_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/no_call_history"
                    android:visibility="@{viewModel.callLogs.empty &amp;&amp; viewModel.filter == CallLogsFilter.ALL ? View.VISIBLE : View.GONE}" />

                <TextView
                    style="@style/empty_list_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/no_missed_call_history"
                    android:visibility="@{viewModel.callLogs.empty &amp;&amp; viewModel.filter == CallLogsFilter.MISSED ? View.VISIBLE : View.GONE}" />
-->

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:background="?attr/dividerColor" />

            </RelativeLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/history_nav_container"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:defaultNavHost="false"
                app:navGraph="@navigation/history_nav_graph"/>

        </androidx.slidingpanelayout.widget.SlidingPaneLayout>


        <View
            android:id="@+id/popup_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/voip_translucent_popup_background"
            android:onClick="@{() -> viewModel.hideContextMenu(true)}"
            android:visibility="@{viewModel.isContextMenuOpen ? View.VISIBLE : View.GONE, default=gone}" />
        <!-- TODO: add click to close -->

        <include
            android:id="@+id/history_context_menu"
            layout="@layout/call_history_make_call_dialog"
            app:historyViewModel="@{viewModel}"
            app:callViewModel="@{contextItemViewModel}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:translationY="@{viewModel.contextMenuTranslateY, default=@dimen/voip_call_extra_buttons_translate_y}"
            android:visibility="@{viewModel.isContextMenuOpen ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="@dimen/voip_extra_menu_max_width" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
