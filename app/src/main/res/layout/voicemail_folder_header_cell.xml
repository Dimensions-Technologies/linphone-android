<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="item"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListItem" />

        <variable
            name="viewModel"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/backgroundColor"
        android:gravity="center_vertical"
        android:onClick="@{() -> viewModel.onFolderClicked(item)}"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@{item.expanded ? @drawable/ic_voicemail_expand_less : @drawable/ic_voicemail_expand_more}" />

        <TextView
            style="@style/contact_name_list_cell_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{item.title}"
            android:textStyle="bold" />
    </LinearLayout>
</layout>
