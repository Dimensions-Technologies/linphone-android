<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListItem" />

        <variable
            name="viewModel"
            type="org.linphone.activities.main.history.viewmodels.VoicemailListViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/backgroundColor"
        android:orientation="vertical">

        <!-- Tapping the row expands it to show the transcription and actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:onClick="@{() -> viewModel.onMessageClicked(item)}"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="10dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@{item.isPlaying ? @string/voicemail_pause : @string/voicemail_play}"
                    android:onClick="@{() -> viewModel.onPlayClicked(item)}"
                    android:padding="10dp"
                    android:src="@{item.isPlaying ? @drawable/ic_voicemail_pause : @drawable/ic_voicemail_play}"
                    android:visibility="@{item.isLoadingAudio ? View.INVISIBLE : View.VISIBLE}" />

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="@{item.isLoadingAudio ? View.VISIBLE : View.GONE, default=gone}" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/contact_name_list_cell_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@{item.title, default=`Jebediah Springfield`}" />

                <TextView
                    style="@style/contact_number_list_cell_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@{item.subtitle}"
                    android:visibility="@{item.subtitle.empty ? View.GONE : View.VISIBLE}" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/contact_number_list_cell_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.date.empty ? item.time : item.date + ` ` + item.time, default=`Yesterday 09:37`}" />

                <TextView
                    style="@style/contact_number_list_cell_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.length, default=`00:12`}" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:contentDescription="@null"
                android:src="@{item.expanded ? @drawable/ic_voicemail_expand_less : @drawable/ic_voicemail_expand_more}" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="54dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:visibility="@{item.expanded ? View.VISIBLE : View.GONE, default=gone}"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                android:indeterminate="true"
                android:visibility="@{item.loadingTranscription ? View.VISIBLE : View.GONE}" />

            <TextView
                style="@style/contact_name_list_cell_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voicemail_transcription"
                android:textStyle="bold"
                android:visibility="@{item.loadingTranscription ? View.GONE : View.VISIBLE}" />

            <TextView
                style="@style/contact_number_list_cell_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@{item.transcription != null ? item.transcription : @string/voicemail_no_transcription}"
                android:textIsSelectable="true"
                android:visibility="@{item.loadingTranscription ? View.GONE : View.VISIBLE}" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voicemail_save"
                    android:enabled="@{!item.busy}"
                    android:alpha="@{item.busy ? 0.4f : 1f}"
                    android:onClick="@{() -> viewModel.onSaveClicked(item)}"
                    android:padding="10dp"
                    android:src="@drawable/ic_voicemail_save"
                    android:visibility="@{item.canSave ? View.VISIBLE : View.GONE}" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voicemail_delete"
                    android:enabled="@{!item.busy}"
                    android:alpha="@{item.busy ? 0.4f : 1f}"
                    android:onClick="@{() -> viewModel.onDeleteClicked(item)}"
                    android:padding="10dp"
                    android:src="@drawable/ic_voicemail_delete" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/call_detail_view"
                    android:onClick="@{() -> viewModel.onViewDetailsClicked(item)}"
                    android:padding="10dp"
                    android:src="@drawable/ic_call_detail_details"
                    android:visibility="@{item.hasCallDetails ? View.VISIBLE : View.GONE}" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/voicemail_call_back"
                    android:onClick="@{() -> viewModel.onCallClicked(item)}"
                    android:padding="10dp"
                    android:src="@drawable/ic_voicemail_call"
                    android:visibility="@{item.canCall ? View.VISIBLE : View.GONE}" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
